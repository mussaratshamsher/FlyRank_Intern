# SQLite database file (relative to the project directory).
DATABASE_PATH=jobs.db

# Maximum attempts per job before it is permanently marked "failed".
MAX_ATTEMPTS=3

# Base delay (seconds) for exponential backoff.
#   delay = BACKOFF_BASE * (2 ** (attempt - 1))
# e.g. 0.5, 1.0, 2.0 for attempts 1, 2, 3.
BACKOFF_BASE=0.5

# "true" = FastAPI starts an in-process worker thread on startup.
# "false" = run a standalone worker with `python -m app.worker`.
RUN_WORKER=true

